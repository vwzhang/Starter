@inject NavigationManager Navigation
@inject ShellStateService Shell

@* MudBlazor providers — rendered once for the whole app. *@
<MudThemeProvider @bind-IsDarkMode="Shell.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        @if (Sidebar is not null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                           Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Toggle navigation" />
        }
        <div class="appbar-brand">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesomeMosaic" Size="Size.Medium" />
            <span>Starter</span>
        </div>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="authState">
                <div class="appbar-auth">
                    <MudText Typo="Typo.caption" Class="appbar-auth-status">
                        Signed in as @GetDisplayName(authState.User)
                    </MudText>
                    <form method="post" action="/admin/sign-out" class="appbar-auth-form">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                            Sign out
                        </MudButton>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="appbar-auth">
                    <MudText Typo="Typo.caption" Class="appbar-auth-status">Guest</MudText>
                    <MudButton Href="@LoginHref" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">
                        Login
                    </MudButton>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Inherit" OnClick="ToggleDarkMode"
                       Icon="@(Shell.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       aria-label="Toggle dark mode" />
    </MudAppBar>

    @if (Sidebar is not null)
    {
        <MudDrawer @bind-Open="Shell.DrawerOpen" Width="300px" Elevation="2"
                   ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive">
            @Sidebar
        </MudDrawer>
    }

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @ChildContent
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    /// <summary>Optional left navigation region. When null the shell has no drawer.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string LoginHref => $"/admin/login?returnUrl={Uri.EscapeDataString(LocalReturnUrl)}";

    private string LocalReturnUrl
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            return string.IsNullOrWhiteSpace(relativePath) ? "/" : "/" + relativePath;
        }
    }

    private void ToggleDrawer() => Shell.DrawerOpen = !Shell.DrawerOpen;
    private void ToggleDarkMode() => Shell.IsDarkMode = !Shell.IsDarkMode;

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        return user.Identity?.Name
            ?? user.FindFirst("name")?.Value
            ?? user.FindFirst("email")?.Value
            ?? "user";
    }
}
