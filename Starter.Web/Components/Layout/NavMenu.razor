@inject NavRegistry Registry
@inject ShellStateService Shell
@inject NavigationManager Navigation
@implements IDisposable

<div class="nav-shell">
    @if (Registry.Modules.Count > 1)
    {
        @* Rail: one tab per module. Hidden automatically when there's only one. *@
        <div class="nav-rail">
            @for (var i = 0; i < Registry.Modules.Count; i++)
            {
                var index = i;
                var module = Registry.Modules[index];
                <MudTooltip Text="@module.Title" Placement="Placement.Right">
                    <MudIconButton Icon="@module.Icon" Size="Size.Large"
                                   Color="@(index == Shell.ActiveModuleIndex ? Color.Primary : Color.Default)"
                                   OnClick="@(() => Shell.ActiveModuleIndex = index)" />
                </MudTooltip>
            }
        </div>
    }

    @* Panel: the active module's own navigation markup. *@
    <div class="nav-panel">
        <MudText Typo="Typo.subtitle2" Class="px-4 py-3 mud-text-secondary">@ActiveModule.Title</MudText>
        <DynamicComponent Type="ActiveModule.NavComponent" />
    </div>
</div>

@code {
    private NavModule ActiveModule => Registry.Modules[Shell.ActiveModuleIndex];

    protected override void OnInitialized()
    {
        SyncActiveModuleWithUrl();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        SyncActiveModuleWithUrl();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncActiveModuleWithUrl()
    {
        var relativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var moduleTitle = relativePath.StartsWith("/dev", StringComparison.OrdinalIgnoreCase)
            ? "Dev"
            : relativePath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
                || relativePath.StartsWith("/account", StringComparison.OrdinalIgnoreCase)
                    ? "Admin"
                    : "Demo";

        var index = Registry.Modules
            .Select((module, moduleIndex) => new { module.Title, Index = moduleIndex })
            .FirstOrDefault(module => module.Title == moduleTitle)?.Index;

        if (index is not null)
        {
            Shell.ActiveModuleIndex = index.Value;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
