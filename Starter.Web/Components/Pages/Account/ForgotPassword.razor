@page "/account/forgot-password"
@layout BlankLayout
@attribute [AllowAnonymous]

<PageTitle>Forgot Password</PageTitle>

<MudStack Spacing="4" Class="admin-login">
    <MudPaper Class="pa-6 admin-login-panel" Outlined="true">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h4">Reset password</MudText>

            @if (Sent == "1")
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">If the account exists, a reset link has been generated.</MudAlert>

                @if (!string.IsNullOrWhiteSpace(ResetLink))
                {
                    <MudTextField Label="Development reset link" Value="@ResetLink" Variant="Variant.Outlined" ReadOnly="true" Lines="4" />
                    <MudButton Href="@ResetLink" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key">
                        Open reset link
                    </MudButton>
                }
            }

            <form method="post" action="/account/forgot-password" class="admin-login-form">
                <input name="Email" type="email" autocomplete="username" placeholder="Email" required />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MarkEmailRead">
                    Send reset link
                </MudButton>
            </form>

            <MudButton Href="/admin/login" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">
                Sign in
            </MudButton>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "sent")]
    public string? Sent { get; set; }

    [SupplyParameterFromQuery(Name = "resetLink")]
    public string? ResetLink { get; set; }
}
